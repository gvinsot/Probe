# Deployment variables for the Probe Swarm stack.
# Copy this file to `.env` (gitignored) and adjust as needed.

# Public hostname the promotional website is served on.
PROBE_WEB_DOMAIN=probe.technology

# Public hostname the web application (the hub) is served on.
PROBE_APP_DOMAIN=app.probe.technology

# --- Probe Desktop updates -------------------------------------------------
# Base64 Ed25519 private key the website signs download/latest.json with.
# Installed Probe Desktops only accept a manifest signed by a key listed in
# desktop/internal/update/update.go (trustedKeys). Generate a pair with:
#   cd app && go run ./tools/manifest keygen
# Empty: the site serves the downloads but no signature, so no Desktop
# updates itself. PulsarCD mounts it as a secret (the _KEY suffix).
PROBE_UPDATE_SIGNING_KEY=

# --- Docker Hub ------------------------------------------------------------
# After each production deployment, docker-compose.post.sh pushes the hub
# image to <DOCKERHUB_USERNAME>/probe-hub:vX.Y.Z and :latest. Empty: nothing
# is published. Use an access token limited to that repository.
DOCKERHUB_USERNAME=
DOCKERHUB_TOKEN=

# --- Web application -------------------------------------------------------
# Swarm node the hub runs on. Its data volume is local to that node: moving
# the hub elsewhere starts it from an empty state unless the volume is copied.
# PROBE_HUB_NODE=server-b

# The stack deploys the hub without credentials, so the domain answers as soon
# as DNS points at the edge; the sign-in page then states that no forge is
# configured. Sign-in starts working once an OAuth application is registered
# and its two variables are set here. Set this to false to make a missing
# forge a startup error instead.
PROBE_HUB_ALLOW_NO_FORGE=true

# Register the OAuth application on the forge with:
#   callback  https://app.probe.technology/auth/github/callback   (scopes repo,read:org)
#   callback  https://app.probe.technology/auth/gitlab/callback   (scope api)
# PROBE_HUB_GITHUB_CLIENT_ID=
# PROBE_HUB_GITHUB_CLIENT_SECRET=
# PROBE_HUB_GITLAB_CLIENT_ID=
# PROBE_HUB_GITLAB_CLIENT_SECRET=

# GitHub Enterprise or a self-managed GitLab only needs its hosts here.
# PROBE_HUB_GITHUB_URL=https://github.com
# PROBE_HUB_GITHUB_API_URL=https://api.github.com
# PROBE_HUB_GITLAB_URL=https://gitlab.com

# The public stack uses auto: lint without a provider, read-only AI review when
# endpoint and model are both configured. Neither executes repository code.
# PROBE_REVIEWER_ENDPOINT=https://provider.example/v1
# PROBE_REVIEWER_MODEL=your-tool-capable-model
# PROBE_API_KEY=
# Concurrent analyses (the swarm stack defaults to 1, so that reviews do not
# compete for a shared reviewer endpoint).
# PROBE_HUB_WORKERS=1
# PROBE_HUB_DEFAULT_BRANCH_ONLY=false

# 64 hex characters. Generated and persisted in the data volume when unset;
# set it to keep sessions valid across a volume rebuild. Required with a
# database: copy the value of session.key from the volume before switching.
# PROBE_HUB_SESSION_KEY=

# PostgreSQL holding the hub state instead of the volume. On its first start
# with a database, the hub imports the volume into it, once; the volume is
# left untouched. Create the database and its user with create-app-user.sh
# of the PostgreSqlCluster repository. The _CONNECTION_STRING suffix makes
# PulsarCD deploy it as a Docker secret, never as a plain variable.
# PROBE_HUB_DATABASE_CONNECTION_STRING=postgresql://probe_app:change-me@pg-primary:5432,pg-standby1:5432,pg-standby2:5432/probe?target_session_attrs=read-write&connect_timeout=10&application_name=probe-hub

# --- LLM / read-only AI review ---------------------------------------------
# Configure these in devops/.env, then redeploy the Hub with the updated image.
# The provider must support the OpenAI-compatible Chat Completions API with
# function calling (tools). MODEL is the exact model ID served by that provider.
# ENDPOINT accepts a /v1 base URL or the full /v1/chat/completions URL.
# Remote endpoints require HTTPS by default. For an HTTP server on your trusted
# internal network, explicitly set ALLOW_INSECURE_HTTP=true below: source and
# API key will travel unencrypted. Inside Docker, localhost refers to the Hub
# container, not the host or another server.
#
# Example template: replace the hostname, model ID and key with your values:
# PROBE_REVIEWER_ENDPOINT=https://llm.example.com/v1
# PROBE_REVIEWER_MODEL=your-model-id
# PROBE_API_KEY=your-provider-api-key
#
# Internal HTTP example (replace the address, port and model). A Swarm LLM
# service is reached by name over the external llm-net network the hub joins;
# always give its port, since without one HTTP means port 80:
# PROBE_REVIEWER_ENDPOINT=http://vllm-dev-service:8000/v1
# PROBE_REVIEWER_ENDPOINT=http://192.168.1.27:8000/v1
# PROBE_REVIEWER_MODEL=your-model-id
# PROBE_REVIEWER_ALLOW_INSECURE_HTTP=true
#
# Leave both ENDPOINT and MODEL empty to keep lint. Set both to enable read-only
# AI review automatically on the public stack (HUB_MODE is fixed to auto).
# Setting only one is a startup error. No repository code or tests are executed.
# API_KEY may stay empty if the provider requires no authentication. With
# PulsarCD, a configured _KEY is mounted as /run/secrets/PROBE_API_KEY.
# Keep real keys in the gitignored .env, never in this example file.
PROBE_REVIEWER_ENDPOINT=
PROBE_REVIEWER_MODEL=
PROBE_API_KEY=
PROBE_REVIEWER_ALLOW_INSECURE_HTTP=false
#
# Optional tuning of the model. PROVIDER is sent as the request's "provider"
# field (OpenRouter provider routing): comma-separated names restrict the
# request to those providers in that order, e.g. anthropic,google-vertex;
# a JSON object such as {"order":["anthropic"],"allow_fallbacks":true} is
# sent as is. TEMPERATURE is the sampling temperature, 0 to 2. Empty leaves
# the provider's defaults. Both also apply to the LLM gateway.
PROBE_REVIEWER_PROVIDER=
PROBE_REVIEWER_TEMPERATURE=
# Existing cached lint reports keep their mode: explicitly rerun an analysis
# after redeploying. The UI then shows "AI review (read-only)" for the new run.
