{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "SwiftProof",
          "version": "v1.2.3",
          "semanticVersion": "1.2.3",
          "informationUri": "https://github.com/gvinsot/SwiftProof",
          "rules": [
            {
              "id": "swiftproof/reproduced",
              "name": "Reproduced",
              "shortDescription": {
                "text": "A generated test passed on the baseline and failed on the candidate."
              },
              "fullDescription": {
                "text": "A model-written generated test passed on a live baseline run and failed on the candidate under the same command, and SwiftProof re-derived both outcomes from the recorded named-test execution. The severity is the reviewer model's classification."
              },
              "help": {
                "text": "Reproduced means only that this recorded experiment passed on the baseline and failed on the candidate. It does not confirm a defect and does not show that the test's assertion encodes the intended behavior; a human judges the assertion. Only a high or critical reproduced hypothesis produces exit code 1, which is also the only case this rule reports at level error."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "swiftproof",
                  "reproduced"
                ]
              }
            },
            {
              "id": "swiftproof/base-test-fails-on-candidate",
              "name": "BaseTestFailsOnCandidate",
              "shortDescription": {
                "text": "The baseline version of a test that the change edited passed on the baseline and failed on candidate code."
              },
              "fullDescription": {
                "text": "The baseline version of a Go test function that the change modified or removed passed on a live baseline run and failed on the candidate tree with that package's test files reverted to the baseline, under the same command."
              },
              "help": {
                "text": "This is a behavior change accompanied by a test edit, for a human to judge. It is not a reproduced issue: the change may intend the new behavior, the baseline assertion may not be the intended behavior, a flaky test can produce it, and it does not show that the test edit is wrong or deliberate. It never produces exit code 1."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "swiftproof",
                  "base_test_fails_on_candidate"
                ]
              }
            },
            {
              "id": "swiftproof/fuzz-divergence",
              "name": "FuzzDivergence",
              "shortDescription": {
                "text": "Identical seeded inputs gave different recorded values on the baseline and the candidate."
              },
              "fullDescription": {
                "text": "Differential fuzzing ran a changed function on identical seeded inputs on both revisions, and a confirmation pair, whose baseline run was live, recorded the same difference. No model chose the inputs."
              },
              "help": {
                "text": "A divergence records a difference between recorded values for recorded inputs. It does not establish which revision is correct and is not a defect report; the values are bounded, redacted serializations. It never produces exit code 1."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "swiftproof",
                  "fuzz_divergence"
                ]
              }
            },
            {
              "id": "swiftproof/observed-divergence",
              "name": "ObservedDivergence",
              "shortDescription": {
                "text": "A generated test recorded different values on the baseline and the candidate for the same inputs."
              },
              "fullDescription": {
                "text": "A model-written generated test recorded values instead of asserting them, and a recorded key differed between the candidate and two baseline runs that agreed with each other, the second of them live."
              },
              "help": {
                "text": "The reviewer model chose the inputs. A divergence records a difference, not which revision is correct, and is not a defect report; the values are bounded, redacted serializations. It never produces exit code 1."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "swiftproof",
                  "observed_divergence"
                ]
              }
            },
            {
              "id": "swiftproof/intent-test-failed",
              "name": "IntentTestFailed",
              "shortDescription": {
                "text": "A model-written test for an acceptance criterion failed on the candidate."
              },
              "fullDescription": {
                "text": "A model-written test for one quoted acceptance criterion, which references symbols the change added or modified, failed on an assertion when it ran on the candidate only."
              },
              "help": {
                "text": "There is no baseline control, and the test or its reading of the criterion may be wrong. It is not a reproduction and does not show that the change departs from the intent. It never produces exit code 1."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "swiftproof",
                  "intent_test_failed"
                ]
              }
            },
            {
              "id": "swiftproof/surviving-mutant",
              "name": "SurvivingMutant",
              "shortDescription": {
                "text": "A single mutation of an added line left the package's tests passing."
              },
              "fullDescription": {
                "text": "A deterministic single change to an added Go line was applied in a private copy of the candidate, and the configured package test command passed on it, as it did on the unmodified control run."
              },
              "help": {
                "text": "The mutant may be semantically equivalent to the original code, and the tests of other packages were not run. It is not a defect, dead code or a missing test by itself, and no mutation score is computed. It does not request review on its own."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "swiftproof",
                  "surviving_mutant"
                ]
              }
            }
          ]
        }
      },
      "invocations": [
        {
          "executionSuccessful": true,
          "exitCode": 1,
          "toolExecutionNotifications": [
            {
              "level": "warning",
              "message": {
                "text": "Check \"candidate-1\" (generated_test_candidate) is FAIL; inspect its recorded output."
              },
              "properties": {
                "swiftproof_kind": "check_not_passed"
              }
            },
            {
              "level": "warning",
              "message": {
                "text": "Check \"check-2-4\" (base_test_hybrid) is FAIL; inspect its recorded output."
              },
              "properties": {
                "swiftproof_kind": "check_not_passed"
              }
            },
            {
              "level": "warning",
              "message": {
                "text": "Check \"check-2-7\" (impacted_test_candidate) is FAIL; inspect its recorded output."
              },
              "properties": {
                "swiftproof_kind": "check_not_passed"
              }
            },
            {
              "level": "warning",
              "message": {
                "text": "Check \"check-1-19\" (generated_test_intent) is FAIL; inspect its recorded output."
              },
              "properties": {
                "swiftproof_kind": "check_not_passed"
              }
            },
            {
              "level": "warning",
              "message": {
                "text": "An existing test that the change did not edit, statically linked to a changed function, passed on the baseline and failed on the candidate. No location in the changed files is recorded for this finding. Evidence: \"evidence-1-7\"; checks: \"check-1-7, check-2-7\". It is listed in PR_COMMENT.md, and its records are in confidence-report.json."
              },
              "properties": {
                "swiftproof_kind": "unanchored_finding"
              }
            }
          ]
        }
      ],
