{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "SwiftProof",
          "version": "v1.2.3",
          "semanticVersion": "1.2.3",
          "informationUri": "https://github.com/gvinsot/SwiftProof",
          "rules": [
            {
              "id": "swiftproof/reproduced",
              "name": "Reproduced",
              "shortDescription": {
                "text": "A generated test passed on the baseline and failed on the candidate."
              },
              "fullDescription": {
                "text": "A model-written generated test passed on a live baseline run and failed on the candidate under the same command, and SwiftProof re-derived both outcomes from the recorded named-test execution. The severity is the reviewer model's classification."
              },
              "help": {
                "text": "Reproduced means only that this recorded experiment passed on the baseline and failed on the candidate. It does not confirm a defect and does not show that the test's assertion encodes the intended behavior; a human judges the assertion. Only a high or critical reproduced hypothesis produces exit code 1, which is also the only case this rule reports at level error."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "swiftproof",
                  "reproduced"
                ]
              }
            }
          ]
        }
      },
      "invocations": [
        {
          "executionSuccessful": true,
          "exitCode": 1,
          "toolExecutionNotifications": [
            {
              "level": "warning",
              "message": {
                "text": "Check \"candidate\" (generated_test_candidate) is FAIL; inspect its recorded output."
              },
              "properties": {
                "swiftproof_kind": "check_not_passed"
              }
            }
          ]
        }
      ],
      "originalUriBaseIds": {
        "%SRCROOT%": {
          "description": {
            "text": "The repository root at the candidate commit."
          }
        },
        "SWIFTPROOF_REPORT": {
          "description": {
            "text": "The SwiftProof report directory (--out), which holds the retained artifacts."
          }
        }
      },
      "columnKind": "utf16CodeUnits",
      "results": [
        {
          "ruleId": "swiftproof/reproduced",
          "ruleIndex": 0,
          "level": "error",
          "message": {
            "text": "A generated test passed on the baseline and failed on the candidate. Severity high was assigned by the reviewer model. Reviewer-model title: \"Regression\". Generated test: \"guest_test.go (TestRegression)\". Runs: \"baseline check base PASS; candidate check candidate FAIL (go_test_json)\". Evidence: \"experiment\". Location: model-chosen location."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "auth.go",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 3,
                  "endLine": 3
                }
              }
            }
          ],
          "relatedLocations": [
            {
              "id": 1,
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "artifacts/0a1b2c3d-generated-test-1-guest_test.go",
                  "uriBaseId": "SWIFTPROOF_REPORT"
                }
              },
              "message": {
                "text": "Retained generated_test artifact, sha256 aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa."
              }
            }
          ],
          "partialFingerprints": {
            "swiftproof/v1": "6c737ddc8e7175d900389e182e8f34a8"
          },
          "properties": {
            "swiftproof": {
              "class": "reproduced",
              "status": "REPRODUCED",
              "severity": "high",
              "severity_source": "reviewer model",
              "title": "Regression",
              "title_source": "reviewer model",
              "location_source": "model-chosen location",
              "location_precision": "line",
              "evidence_ids": [
                "experiment"
              ],
              "check_ids": [
                "base",
                "candidate"
              ],
              "hypothesis_ids": [
                "h1"
              ],
              "details": [
                {
                  "label": "generated test",
                  "value": "guest_test.go (TestRegression)"
                },
                {
                  "label": "runs",
                  "value": "baseline check base PASS; candidate check candidate FAIL (go_test_json)"
                }
              ],
              "artifacts": [
                {
                  "kind": "generated_test",
                  "path": "artifacts/0a1b2c3d-generated-test-1-guest_test.go",
                  "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
                }
              ]
            }
          }
        }
      ],
      "properties": {
        "swiftproof": {
          "report_version": 1,
          "tool_version": "v1.2.3",
          "generated_at": "2026-09-26T12:00:00Z",
          "base_ref": "main",
          "head_ref": "HEAD",
          "base_commit": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
          "head_commit": "cccccccccccccccccccccccccccccccccccccccc",
          "base_ref_commit": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
          "policy_source": "explicit",
          "exit_code": 1,
          "findings": 1,
          "unanchored_findings": 0,
          "omitted_findings": 0,
          "unverified_areas": 0,
          "unverified_hypotheses": 0,
          "checks_not_passed": 1,
          "stages_not_run": 0,
          "risk_signals": 0,
          "review_targets": 1,
          "note": "Only evidence-backed findings are listed as results. An empty result list is not an approval and does not establish that the change is correct; GitHub's fixed state of an alert is not a SwiftProof claim. A re-rendered or fork-produced file is not authenticated."
        }
      }
    }
  ],
  "properties": {
    "attribution": "Generated by SwiftProof v1.2.3 (https://github.com/gvinsot/SwiftProof)."
  }
}
